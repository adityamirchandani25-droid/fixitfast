# Copy this file to .env and fill in the required service credentials.

# --- Public site URL ------------------------------------------------------
# Exact production origin, with https and no trailing slash.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Database -----------------------------------------------------------
# Local Postgres (docker compose up -d, see README) or any Postgres URL.
DATABASE_URL="postgresql://fixitnow:fixitnow@localhost:5432/fixitnow?schema=public"
# Optional separate non-transaction-pooled URL for Prisma migrations.
DIRECT_URL=""

# --- Auth (Supabase Auth) -------------------------------------------------
# Supabase Dashboard -> Connect -> Framework, or Project Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
# server-only — never NEXT_PUBLIC_, never sent to the client

# --- Stripe (test mode) ---------------------------------------------------
# Use Stripe test keys locally and live keys only in the production environment.
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""

# --- Address geocoding ----------------------------------------------------
# Required to turn service addresses into real coordinates for matching.
MAPBOX_TOKEN=""

# --- Analytics (optional, only loaded after cookie consent) ---------------
# Google Analytics measurement ID. Leave unset in preview/staging so those
# deploys don't report into the production property.
NEXT_PUBLIC_GA_MEASUREMENT_ID=""

# --- Map tiles (optional) --------------------------------------------------
# Defaults to the public OpenStreetMap tile server if unset. Point this at
# your own tile provider (e.g. Mapbox, MapTiler) to avoid sending visitor
# IPs to a third party and to stay within OSM's usage policy at scale.
NEXT_PUBLIC_MAP_TILE_URL=""
